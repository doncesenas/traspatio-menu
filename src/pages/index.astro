---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="MariaChelas - Restaurante Bar" showNavbar={false}>
    <section
        class="relative flex flex-col items-center justify-center text-center px-6 py-24 pb-40"
    >
        <img
            src="/logodef.png"
            alt="LogoMariaChelas"
            class="w-auto h-auto mx-auto rounded-full object-cover shadow-md mb-6 max-w-[300px]"
        />
        <h1 class="text-5xl font-bold text-[#ffcc3d] mb-7">
            Bienvenido a Maria Chelas | Restaurante-Bar
        </h1>
        <p class="text-lg text-[#FFFFF] -600 mb-6">
            Disfruta la música, comida y nuestra terraza
        </p>
        <a
            href="/menu"
            class="bg-[#e67e22] text-white px-6 py-3 rounded-lg hover:bg-[#f5a30c] transition"
        >
            Ver menú
        </a>
    </section>
</BaseLayout>
