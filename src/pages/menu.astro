        <div data-category="cocteleria" class="menu-section">
            <SectionTitle title="Mixiología" />
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                <MenuCard
                    name="Mezcalita"
                    comment="Refrescantes y con el toque ahumado del mezcal, combinadas con jugos frutales que realzan su sabor. ¡Perfectas para quienes buscan algo diferente! Piña Colada"
                    price="$140"
                    image="/images/mezcalitas.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Piña Colada"
                    comment="La clásica mezcla tropical de piña, coco y ron. Cremosa, dulce y con ese sabor a vacaciones que todos disfrutan."
                    price="$130"
                    image="/images/piña.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Pantera Rosa"
                    comment="Una bebida suave y deliciosa, con un toque de fresa y crema que conquista a quien la prueba. ¡Tan buena como su nombre!"
                    price="$130"
                    image="/images/pantera.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Vampiro"
                    comment="El trago con más sabor mexicano: tequila, jugo de naranja, sangrita y un toque de picor que enciende la fiesta."
                    price="$130"
                    image="/images/vampirito.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Paloma"
                    comment="Refrescante y tradicional, hecha con tequila, refresco de toronja y un toque de limón y sal. ¡Un clásico que nunca falla!"
                    price="$130"
                    image="/images/paloma.webp"
