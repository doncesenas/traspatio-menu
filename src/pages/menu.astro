                />
                <MenuCard
                    name="Vaso Chelado"
                    comment=""
                    price="$25"
                    image="/images/vasochelado.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Vaso con clamato"
                    comment=""
                    price="$60"
                    image="/images/vasoclamato.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Vaso Michelado"
                    comment=""
