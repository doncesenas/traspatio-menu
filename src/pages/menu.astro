                    loading="lazy"
                />
            </div>
        </div>

        <div data-category="mixtos" class="menu-section">
            <SectionTitle title="Mixtos" />
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                <MenuCard
                    name="Ceviche Mixto"
                    comment="Camarón y pescado con verduras frescas (Para 3 personas)"
                    price="$180"
                    image="/images/cevichemixto.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Tostada mixta"
                    comment="Tostada de Camarón y pescado con verduras frescas "
                    price="$80 c/u"
                    image="/images/tostadamixta.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Molcajete Mar y Tierra"
                    comment="250g de camarones al gusto y 300g de jugoso sirloin, acompañados de tostada con guacamole, cebollitas y chile toreado. ¡Un festín de sabores en tu mesa!"
