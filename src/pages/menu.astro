---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import MenuCard from "../components/MenuCard.astro";
---

<BaseLayout title="Menú | Traspatio Mar & Grill">
    <section class="max-w-6xl mx-auto px-6 pt-24 pb-16">
        <img
            src="/logo.jpg"
            alt="Logo Traspatio Mar & Grill"
            class="w-32 h-32 mx-auto rounded-full object-cover shadow-md mb-6"
        />
        <h1 class="text-4xl font-bold text-center text-[#79B743] mb-10">
            Nuestro Menú
        </h1>

        <!-- Sections -->
        <div
            id="menu-tabs"
            class="flex justify-center flex-wrap gap-6 mb-10 text-lg font-medium text-stone-100"
        >
            <span
                class="tab-item border-b-2 border-transparent hover:text-[#79B743] transition-all duration-300 cursor-pointer active"
                data-section="todo">Todo</span
            >
            <span
                class="tab-item border-b-2 border-transparent hover:text-[#79B743] transition-all duration-300 cursor-pointer"
                data-section="entradas">Entradas</span
            >
            <span
                class="tab-item border-b-2 border-transparent hover:text-[#79B743] transition-all duration-300 cursor-pointer"
                data-section="mariscos">Mariscos</span
            >
            <span
                class="tab-item border-b-2 border-transparent hover:text-[#79B743] transition-all duration-300 cursor-pointer"
                data-section="aguachiles">Aguachiles</span
            >
            <span
                class="tab-item border-b-2 border-transparent hover:text-[#79B743] transition-all duration-300 cursor-pointer"
                data-section="parrilladas">Parrilladas</span
            >
            <span
                class="tab-item border-b-2 border-transparent hover:text-[#79B743] transition-all duration-300 cursor-pointer"
                data-section="mixtos">Mixtos</span
            >
            <span
                class="tab-item border-b-2 border-transparent hover:text-[#79B743] transition-all duration-300 cursor-pointer"
                data-section="tacos-y-tostadas">Tacos y Carnes</span
            >
            <span
                class="tab-item border-b-2 border-transparent hover:text-[#79B743] transition-all duration-300 cursor-pointer"
                data-section="bebidas">Bebidas</span
            >
            <span
                class="tab-item border-b-2 border-transparent hover:text-[#79B743] transition-all duration-300 cursor-pointer"
                data-section="cocteleria">Coctelería</span
            >
        </div>

        <div data-category="entradas" class="menu-section">
            <SectionTitle title="Entradas" />
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                <MenuCard
                    name="Queso fundido"
                    comment="Delicioso queso flameado con sirloin para abrir el apetito"
                    price="$140"
                    image="/images/queso.webp"
                    loading="lazy"
                />
                <MenuCard
