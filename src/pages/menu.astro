                    price="$110"
                    image="/images/flautas.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Guacamole con carnitas"
                    comment="Guacamole con carnitas de cerdo 250g"
                    price="$150"
                    image="/images/carnitas.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Guacamole con costillas tajín"
                    comment="Guacamole con costillas al tajín 250g"
                    price="$165"
                    image="/images/costillas.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Guacamole con pico de gallo"
                    comment="Delicioso queso flameado con sirloin para abrir el apetito"
                    price="$120"
                    image="/images/guacamole.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Quesadillas"
                    comment="Tortilla rellena de queso fundido (3 pzas)."
                    price="$80"
                    image="/images/quesadillas.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Papas a la francesa"
                    comment="Papas fritas estilo clásico (250 g)."
                    price="$90"
                    image="/images/papasfrancesa.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Nachos tradicionales"
                    comment="Delicioso queso flameado con  para abrir el apetito"
                    price="$90"
                    image="/images/nachos.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Nachos con Sirloin"
                    comment="Delicioso queso flameado con sirloin para abrir el apetito"
