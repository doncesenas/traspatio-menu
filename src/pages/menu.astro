                    loading="lazy"
                />
                <MenuCard
                    name="Ceviche de pescado"
                    comment="Pescado guisado con salsa de la casa (6 pzas)."
                    price="$180"
                    image="/images/cevichepescado.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Tostada de pescado"
                    comment="Tostada de Pescado con salsa de la casa C/U"
                    price="$80"
                    image="/images/tostadapescado.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Filete de pescado empanizado"
                    comment="Filete fresco al grill y empanizado con verduras y papas (500 g)."
                    price="$150"
                    image="/images/filete.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Chicharrón de Pescado"
                    comment="Pescado crujiente puesto en molcajete con una cama de aguacate (250g)"
                    price="$160"
                    image="/images/chicharrondepescado.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Mojarra frita"
                    comment="Mojarra frita acompañada de papas y verduras"
                    price="$150"
                    image="/images/chicharrondecamaron.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Pescado Zarandeado"
