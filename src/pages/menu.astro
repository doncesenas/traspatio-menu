                />
                <MenuCard
                    name="Margarita"
                    comment="Equilibrio perfecto entre lo ácido y lo dulce. Tequila, limón y un toque de licor de naranja servidos en copa escarchada con sal."
                    price="$130"
                    image="/images/margarita.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Perla Negra"
                    comment="Una mezcla energética y misteriosa de licor de hierbas y bebida energizante. Ideal para los que buscan un buen empuje para la noche."
                    price="$130"
                    image="/images/perla.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Desarmador"
                    comment="Vodka con jugo de naranja en una combinación sencilla pero poderosa. Fresco, ligero y con un golpe sutil."
                    price="$130"
                    image="/images/desarmador.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Tequila Sunrise"
                    comment="Tan vistoso como su nombre: tequila, jugo de naranja y granadina, formando un amanecer en tu copa."
                    price="$140"
                    image="/images/tequilasun.webp"
                    loading="lazy"
                />
            </div>
        </div>

        <!--  Script simple para cambiar secciones -->
        <script>
            const tabs = document.querySelectorAll(".tab-item");
            const sections = document.querySelectorAll(".menu-section");

            tabs.forEach((tab) => {
                tab.addEventListener("click", () => {
                    // Quitar clase activa a todos
                    tabs.forEach((t) =>
                        t.classList.remove(
                            "text-[#79B743]",
                            "border-[#79B743]",
                            "active",
                        ),
                    );
                    // Agregar clase activa al actual
                    tab.classList.add(
                        "text-[#79B743]",
                        "border-[#79B743]",
                        "active",
                    );

                    // @ts-ignore
                    const selected = tab.dataset.section;

                    sections.forEach((section) => {
                        if (
                            selected === "todo" ||
                            // @ts-ignore
                            section.dataset.category === selected
                        ) {
                            section.classList.remove("hidden", "opacity-0");
                            section.classList.add("opacity-100");
                        } else {
                            section.classList.add("hidden", "opacity-0");
                            section.classList.remove("opacity-100");
                        }
                    });
                });
            });
        </script>
    </section>
</BaseLayout>
