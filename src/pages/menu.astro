                    loading="lazy"
                />
            </div>
        </div>

        <div data-category="bebidas" class="menu-section">
            <SectionTitle title="Bebidas" />
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                <MenuCard
                    name="Refresco de 355ml"
                    comment="Refresco de 355ml sabor: Coca-Cola Regular, Coca-Cola Light y Fresca de Toronja."
