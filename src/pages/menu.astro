                    name="Guacamole con carnitas de cerdo"
                    comment="Aguacate machacado con pico de gallo, carnitas de cerdo, acompañado de tortillas, totopos y salsa verde."
                    price="$150"
                    image="/images/guacamole-carnitas.webp"
                    loading="lazy"
                    placeholder="blur"
                />

                <MenuCard
                    name="Costillas al tajín"
                    comment="350 gr de flecha de res, guacamole con pico de gallo, cebolla morada y totopos."
                    price="$199"
                    image="/images/costillas-tajin.webp"
                    loading="lazy"
                    placeholder="blur"
                />

                <MenuCard
                    name="Boneless súper crunchy"
                    comment="250 gr de pechuga de pollo empanizado, bañados en salsa, 150 gr de papas a la francesa con lemon pepper, apio, zanahoria y ranch.  Elige la salsa de tu preferencia: buffalo, BBQ o mango habanero."
