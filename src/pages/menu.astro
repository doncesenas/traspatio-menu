                    image="/images/tacoarrachera.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Taco de Diezmillo"
                    comment="Tortilla de maíz con diezmillo asado (3 pzas)"
                    price="$57 c/u"
                    image="/images/tacodiezmillo.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Taco Gobernador"
                    comment="Tortilla de maíz con camaron al grill, aguacate y salsa de"
                    price="$60 c/u"
                    image="/images/tacogober.webp"
                    loading="lazy"
                />
                <MenuCard
                    name="Tostada de carne asada"
                    comment="Tostada de carne asada acompañada con verduras"
                    price="$70 c/u"
                    image="/images/tostadacamaron.webp"
