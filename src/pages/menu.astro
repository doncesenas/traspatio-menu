                    image="/images/crunchy.webp"
                    loading="lazy"
                    placeholder="blur"
                />

                <MenuCard
                    name="Orden de alitas"
                    comment="500gr de alitas bañadas en salsa, 150 gr de papas a la francesa, apio, zanahoria y ranch. Elige la salsa de tu preferencia: buffalo, BBQ o mango habanero."
