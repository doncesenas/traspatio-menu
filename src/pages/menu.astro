---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import MenuCard from "../components/MenuCard.astro";
---

<BaseLayout title="Menú | MariaChelas Monterrey">
    <section
        class="max-w-6xl mx-auto px-6 pt-24 pb-[calc(env(safe-area-inset-bottom)+6rem)]"
    >
        <img
            src="/logow.png"
            alt="Logo Traspatio Mar & Grill"
            class="w-auto h-auto mx-auto rounded-full object-cover shadow-md max-w-[200px]"
        />
        <h1 class="text-4xl font-bold text-center text-[#ffcc3d] mb-7">
            Nuestro Menú
        </h1>

        <!-- Sections -->
        <div
            id="menu-tabs"
            class="flex justify-center flex-wrap gap-6 mb-10 text-lg font-medium text-stone-100"
        >
            <span
                class="tab-item border-b-2 border-transparent hover:text-[#f8ab68] transition-all duration-300 cursor-pointer active"
                data-section="todo">Todo</span
            >
            <span
                class="tab-item border-b-2 border-transparent hover:text-[#f8ab68] transition-all duration-300 cursor-pointer"
                data-section="compartir">Para compartir</span
            >

            <span
                class="tab-item border-b-2 border-transparent hover:text-[#f8ab68] transition-all duration-300 cursor-pointer"
                data-section="mariscos">Del Mar</span
            >

            <span
                class="tab-item border-b-2 border-transparent hover:text-[#f8ab68] transition-all duration-300 cursor-pointer"
                data-section="parrillero">De la Parrilla</span
            >

            <span
                class="tab-item border-b-2 border-transparent hover:text-[#f8ab68] transition-all duration-300 cursor-pointer"
                data-section="tacos">Tacos</span
            >

            <span
                class="tab-item border-b-2 border-transparent hover:text-[#f8ab68] transition-all duration-300 cursor-pointer"
                data-section="postres">Postres</span
            >

            <span
                class="tab-item border-b-2 border-transparent hover:text-[#f8ab68] transition-all duration-300 cursor-pointer"
                data-section="bebidas">Bebidas</span
            >
        </div>

        <div class="text-2xl italic font text-center text-[#ffcc3d] mb-10">
            Nuestros platillos se preparan al momento, con un tiempo de espera
            minimo de 20 minutos.
        </div>

        <div data-category="compartir" class="menu-section">
            <SectionTitle title="" />
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 smoke-reveal">
                <MenuCard
                    name="Nachos con Sirloin"
                    comment="Totopo con queso amarillo, 200 gr de sirloin, jalapeños, frijoles, lechuga y tomate picados."
                    price="$250"
                    image="/images/nachossirloin.webp"
                    loading="lazy"
                    placeholder="blur"
                />

                <MenuCard
                    name="Papas Rancheras"
                    comment="300gr de papa galeana con salsa de chile rojo, limón, parmesano y cilantro."
                    price="$80"
                    image="/images/papas-rancheras.webp"
                    loading="lazy"
                    placeholder="blur"
                />
                <MenuCard
                    name="Papas a la francesa"
                    comment="450 gr de papas sazonadas con lemon pepper"
                    price="$110.00"
                    image="/images/papas-francesa.webp"
                    loading="lazy"
                    placeholder="blur"
                />

                <MenuCard
                    name="Guacamole con pico de gallo"
                    comment="Aguacate machacado con pico de gallo, acompañado de totopos y salsa verde."
                    price="$85"
                    image="/images/guacamole-tacos.webp"
                    loading="lazy"
                    placeholder="blur"
                />

                <MenuCard
                    name="Guacamole con flautas de res"
