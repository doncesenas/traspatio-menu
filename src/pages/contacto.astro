---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
---

<BaseLayout title="Contacto | Traspatio Mar & Grill">
    <section
        class="max-w-6xl mx-auto px-6 pt-32 pb-20 text-center text-stone-100"
    >
        <h1 class="text-4xl md:text-5xl font-bold text-[#e67e22] mb-4">
            Contáctanos
        </h1>
        <p class="text-stone-300 text-lg italic mb-12">
            Estamos listos para atenderte como en casa.
        </p>

        <div
            class="grid md:grid-cols-2 gap-10 items-center bg-black/40 backdrop-blur-md rounded-2xl p-8"
        >
            <!-- 🗺️ Mapa + info -->
            <div class="flex flex-col items-center md:items-start text-left">
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3596.1706412898975!2d-100.31463942393499!3d25.665637512566775!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8662bf0618a59a21%3A0x2f139c2d958aed94!2sMariachelas%20Terraza%20Restaurante%20bar!5e0!3m2!1ses-419!2smx!4v1780354546802!5m2!1ses-419!2smx"
                    class="w-full h-64 rounded-xl shadow-lg mb-6"
                    loading="lazy"></iframe>
                <h3 class="text-2xl font-semibold text-[#f8ab68] mb-2">
                    Nuestra ubicación
                </h3>
                <p class="text-stone-300 text-sm leading-relaxed">
                    Melchor Ocampo #515 Oriente<br />
                    Centro de Monterrey, N.L.
                </p>
                <p class="text-stone-400 mt-3">
                    <span class="font-medium text-[#f8ab68]">Teléfono:</span>
                    +52 81 2003 2013
                </p>
                <p class="text-stone-400">
                    <span class="font-medium text-[#f8ab68]">Email:</span>
                    mariachelasmonterrey@gmail.com
                </p>
            </div>

            <!-- 📨 Formulario -->
            <div class="text-left">
                <h3 class="text-2xl font-semibold text-[#f8ab68] mb-4">
                    Envíanos un mensaje
                </h3>
                <form
                    action="https://formsubmit.co/cesenasdaniel8@gmail.com"
                    method="POST"
                    class="flex flex-col gap-4"
                >
                    <input
                        type="text"
                        name="name"
                        required
                        placeholder="Tu nombre"
                        class="bg-white/10 text-stone-100 placeholder-stone-400 rounded-lg p-3 border border-white/10 focus:outline-none focus:border-[#f8ab68] transition"
                    />
                    <input
                        type="email"
                        name="email"
                        required
                        placeholder="Tu correo"
                        class="bg-white/10 text-stone-100 placeholder-stone-400 rounded-lg p-3 border border-white/10 focus:outline-none focus:border-[#f8ab68] transition"
                    />
                    <textarea
                        name="message"
                        rows="4"
                        placeholder="Tu mensaje..."
                        class="bg-white/10 text-stone-100 placeholder-stone-400 rounded-lg p-3 border border-white/10 focus:outline-none focus:border-[#f8ab68] transition"
                    ></textarea>
                    <button
                        type="submit"
                        class="bg-[#ffcc3d] hover:bg-[#f8ab68] text-white font-medium py-3 px-6 rounded-lg transition"
                    >
                        Enviar mensaje
                    </button>
                </form>
            </div>
        </div>
    </section>
</BaseLayout>
